# ── Env / secrets（example はコミットする）──────────────────────────────────
.env
.env.*
!.env*.example
!.env.example

# ── Test / coverage ──────────────────────────────────────────────────────────
coverage/
.nyc_output/
vitest.config.ts.timestamp-*

# ── Logs / debug ─────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

