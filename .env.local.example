# ─────────────────────────────────────────────────────────────────────────────
# VibeLoop — environment variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API

# Public keys (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Secret key (server-side only — NEVER expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Google Places API (New) ───────────────────────────────────────────────────
# Enable "Places API (New)" in Google Cloud Console → APIs & Services.
# Restrict the key to the Places API only and add server IP allowlist for prod.
# After deploying the /api/photo proxy, rotate any key that was previously embedded in photo URLs.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# ── Google AdSense（将来実装用・現時点では未使用）──────────────────────────────
# 実装前に Google 側で取得する ID をここに置く。空のままでもアプリは動作します。
#
# 取得: https://www.google.com/adsense/ → サイト登録・審査後
#   - Publisher ID（ca-pub- で始まる）
#   - 広告ユニットごとの Slot ID（実装時に複数必要ならコード側で管理）
#
# 審査の目安: 本番ドメイン・プライバシーポリシー・十分なコンテンツ

# AdSense — パブリッシャー ID（例: ca-pub-1234567890123456）
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT_ID=ca-pub-4327087962474660

# AdSense — デフォルト広告スロット ID（1ユニット目。追加は実装時に検討）
NEXT_PUBLIC_GOOGLE_ADSENSE_SLOT_ID=

# ── Hotpepper Gourmet（レストラン予約アフィリエイト）────────────────────────────
# 取得: https://webservice.recruit.co.jp/ → APIキー申請
# アフィリエイト収益: ValueCommerce 経由でホットペッパーグルメの予約完了に応じて発生
#
# ホットペッパー Web サービス API キー
HOTPEPPER_API_KEY=your_hotpepper_api_key_here

# ── ValueCommerce アフィリエイト ──────────────────────────────────────────────
# 取得: https://www.valuecommerce.ne.jp/ → 登録後、ホットペッパーグルメ提携プログラムに参加申請
# SID: サービス ID（your.service.id 形式）
# PID: パブリッシャー ID（数字）
VALUE_COMMERCE_SID=your_valuecommerce_sid_here
VALUE_COMMERCE_PID=your_valuecommerce_pid_here

# ── Admin ─────────────────────────────────────────────────────────────────────
# Required for /admin and /api/admin/* (fail-closed if unset).
ADMIN_SECRET=generate_a_long_random_string_here

# Local-only escape hatch when ADMIN_SECRET is unset (never use in production).
# ALLOW_INSECURE_ADMIN=1

# ── Feedback (optional) ───────────────────────────────────────────────────────
# Settings → Send feedback. When empty, the row is hidden.
# NEXT_PUBLIC_FEEDBACK_URL=https://forms.gle/your-form-id
